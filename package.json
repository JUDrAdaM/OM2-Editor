{
  "name": "omsi2-map-editor",
  "version": "0.0.17-alpha",
  "private": true,
  "description": "Moderní 3D editor map pro OMSI 2",
  "author": "JUDrAdaM",
  "repository": {
    "type": "git",
    "url": "https://github.com/JUDrAdaM/OM2-Editor.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "node scripts/dev.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "three": "^0.169.0"
  },
  "build": {
    "appId": "com.omsi2.om2editor",
    "productName": "OM2-Editor",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "JUDrAdaM",
        "repo": "OM2-Editor",
        "releaseType": "prerelease"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "OM2-Editor-Setup-${version}.${ext}"
    }
  }
}
